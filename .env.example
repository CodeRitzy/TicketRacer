# Ticketracer config. Never commit this file (it is in .gitignore).

# --- Postgres (Docker container; host port 5433 avoids your local 5432) ---
POSTGRES_USER=ticketracer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ticketracer
DATABASE_URL=postgres://ticketracer:change-me@localhost:5433/ticketracer?sslmode=disable

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0

# --- Admin dashboard / simulator API (bearer token; endpoints deny access if empty) ---
ADMIN_TOKEN=change-me

# --- Stripe test mode: fill these in yourself, then leave PAYMENT_MODE=stripe ---
# sk_test_... from Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
# whsec_... printed by: stripe listen --forward-to localhost:8080/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# "demo" = built-in signed fake webhooks (no Stripe needed); "stripe" = real Stripe test mode
PAYMENT_MODE=demo
# Signing secret for demo-mode webhooks
DEMO_WEBHOOK_SECRET=change-me

# --- Booking rules ---
HOLD_TTL_SECONDS=600
MAX_SEATS_PER_HOLD=6
ADMIT_PER_SECOND=50
PUBLIC_URL=http://localhost:8080
