# Optional. The app runs without this file.
# Copy to .env only to use Stripe or change a setting. Never commit .env.
# localpassword1234567890 only works on localhost.

# Database
POSTGRES_USER=ticketracer
POSTGRES_PASSWORD=localpassword1234567890
POSTGRES_DB=ticketracer
DATABASE_URL=postgres://ticketracer:localpassword1234567890@localhost:5433/ticketracer?sslmode=disable

# Redis
REDIS_PASSWORD=localpassword1234567890
REDIS_URL=redis://:localpassword1234567890@localhost:6379/0

# Dashboard login. Use the default, or any value of 24+ characters.
ADMIN_TOKEN=localpassword1234567890

# Payments: "demo" (no Stripe needed) or "stripe"
PAYMENT_MODE=demo
DEMO_WEBHOOK_SECRET=localpassword1234567890
# Stripe only: sk_test_... from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
# Stripe only: the whsec_... secret printed by `stripe listen`
STRIPE_WEBHOOK_SECRET=

# Booking rules
HOLD_TTL_SECONDS=600
MAX_SEATS_PER_HOLD=6
ADMIT_PER_SECOND=50
PUBLIC_URL=http://localhost:8080
